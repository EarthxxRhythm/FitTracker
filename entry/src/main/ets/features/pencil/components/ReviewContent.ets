          .fontColor('#F7FBF8')
        Text('目标 ' + this.goalWeightText() + ' kg')
          .fontFamily('Inter')
          .fontSize(13)
          .fontWeight(FontWeight.Medium)
          .fontColor('#50ECA7')
          .height(36)
          .padding({ left: 14, right: 14 })
          .backgroundColor('#1A50ECA7')
          .borderRadius(999)
          .border({ width: 1, color: '#6150ECA7' })
          .onClick(() => {
            this.openGoalModal()
          })
          .onTouch((event: TouchEvent) => {
            if (event.type === TouchType.Down) {
              this.goalPressed = true
            } else if (event.type === TouchType.Up || event.type === TouchType.Cancel) {
              this.goalPressed = false
            }
          })
          .scale({
            x: this.goalPressed ? MotionTokens.PRESS_SEGMENT : 1,
            y: this.goalPressed ? MotionTokens.PRESS_SEGMENT : 1
          })
          .animation({ duration: MotionTokens.DURATION_PRESS, curve: MotionTokens.EASE_MOTION })
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .alignItems(VerticalAlign.Center)
      .margin({ bottom: 14 })

      Canvas(this.wgContext)
        .width('100%')
        .aspectRatio(342 / 132)
        .onReady(() => {
          this.drawWeightChart()
        })
        .margin({ top: 6 })

      Row() {
        Row() {
          Text('当前')
            .fontFamily('Noto Sans SC')
            .fontSize(12)
            .fontColor('#66FFFFFF')
          Text('69.2 kg')
            .fontFamily('Noto Sans SC')
            .fontSize(17)
            .fontWeight(FontWeight.Medium)
            .fontColor('#F7FBF8')
            .margin({ left: 4 })
        }
        Text('较上月 -0.8 kg')
          .fontFamily('Inter')
          .fontSize(12)
          .fontColor('#66FFFFFF')
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .alignItems(VerticalAlign.Bottom)
      .margin({ top: 8 })
    }
    .width('100%')
    .padding(16.3)
    .backgroundColor('#10171B')
    .borderRadius(25.4)
    .border({ width: 1, color: '#10FFFFFF' })
  }

  @Builder
  private effortCard() {
    Column() {
      Row() {
        Text('努力程度')
          .fontFamily('Noto Sans SC')
          .fontSize(14.5)
          .fontWeight(FontWeight.Bold)
          .fontColor('#F7FBF8')
        Text('Effort · RIR / RPE')
          .fontFamily('Noto Sans SC')
          .fontSize(10.9)
          .fontColor('#66FFFFFF')
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .alignItems(VerticalAlign.Bottom)
      .margin({ bottom: 14 })

      Row() {
        this.openStatsSegment('RIR', 'rir', 'effort')
        this.openStatsSegment('RPE', 'rpe', 'effort')
      }
      .width('100%')
      .padding(3)
      .backgroundColor('#0CFFFFFF')
      .borderRadius(999)
      .border({ width: 1, color: '#1AFFFFFF' })

      Text('RIR 记的是你还剩几次；RPE 用 0–10 表示主观用力，RPE ≈ 10 − RIR。')
        .fontFamily('Noto Sans SC')
        .fontSize(11)
        .fontColor('#66FFFFFF')
        .lineHeight(1.5)
        .margin({ top: 12 })
        .width('100%')

      Row() {
        Text(this.effortAverage())
          .fontFamily('Inter')
          .fontSize(30)
          .fontWeight(FontWeight.Bold)
          .fontColor('#F7FBF8')
        Text(this.effortUnitText())
          .fontFamily('Noto Sans SC')
          .fontSize(12)
          .fontColor('#66FFFFFF')
          .margin({ left: 8 })
      }
      .width('100%')
      .alignItems(VerticalAlign.Bottom)
      .margin({ top: 14 })

      Row({ space: 8 }) {
        ForEach(RIR_BARS, (value: number, index: number) => {
          Column({ space: 6 }) {
            Row()
              .width('100%')
              .height(this.effortBarHeight(index))
              .backgroundColor('#50ECA7')
              .borderRadius(6)
            Text((index + 1).toString())
              .fontFamily('Inter')
              .fontSize(9)
              .fontColor('#66FFFFFF')
          }
          .layoutWeight(1)
          .height(96)
          .justifyContent(FlexAlign.End)
          .alignItems(HorizontalAlign.Center)
        }, (value: number, index: number) => index.toString())
      }
      .width('100%')
      .height(96)
      .alignItems(VerticalAlign.Bottom)
      .margin({ top: 14 })
    }
    .width('100%')
    .padding(16.3)
    .backgroundColor('#10171B')
    .borderRadius(25.4)
    .border({ width: 1, color: '#10FFFFFF' })
  }

  @Builder
  private oneRmCard() {
    Column() {
      Row() {
        Text('估算 1RM')
          .fontFamily('Noto Sans SC')
          .fontSize(14.5)
          .fontWeight(FontWeight.Bold)
          .fontColor('#F7FBF8')
        Text('来自最佳有效组')
          .fontFamily('Noto Sans SC')
          .fontSize(10.9)
          .fontColor('#66FFFFFF')
      }
      .width('100%')
      .justifyContent(FlexAlign.SpaceBetween)
      .alignItems(VerticalAlign.Bottom)
      .margin({ bottom: 14 })

      ForEach(ONE_RM_ROWS, (item: OneRmRowItem, index: number) => {
        Row({ space: 10 }) {
          Text(item.name)
            .fontFamily('Noto Sans SC')
            .fontSize(15)
            .fontColor('#F7FBF8')
            .layoutWeight(1)
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          Text(item.source)
            .fontFamily('Noto Sans SC')
            .fontSize(11)
            .fontColor('#66FFFFFF')
          Row() {
            Text(item.value)
              .fontFamily('Inter')
              .fontSize(17)
              .fontWeight(FontWeight.Bold)
              .fontColor('#F7FBF8')
            Text('kg')
              .fontFamily('Noto Sans SC')
              .fontSize(11)
              .fontWeight(FontWeight.Medium)
              .fontColor('#50ECA7')
              .margin({ left: 2 })
          }
        }
        .width('100%')
        .alignItems(VerticalAlign.Center)
        .padding({ top: 10, bottom: 10 })
        .border({ width: { bottom: index === ONE_RM_ROWS.length - 1 ? 0 : 1 }, color: '#0FFFFFFF' })
      }, (item: OneRmRowItem) => item.name)
    }
    .width('100%')
    .padding(16.3)
    .backgroundColor('#10171B')
    .borderRadius(25.4)
    .border({ width: 1, color: '#10FFFFFF' })
  }

  @Builder
  private goalModal() {
    Stack({ alignContent: Alignment.Center }) {
      Column()
        .width('100%')
        .height('100%')
        .backgroundColor('#9E040608')
        .onClick(() => {
          this.closeGoalModal()
        })
      Column() {
        Text('设置体重目标')
          .fontFamily('Noto Sans SC')
          .fontSize(16)
          .fontWeight(FontWeight.Bold)
          .fontColor('#F7FBF8')
          .width('100%')
        Text('输入你的目标体重，更新曲线上的目标线。')
          .fontFamily('Noto Sans SC')
          .fontSize(12)
          .fontColor('#8AFFFFFF')
          .margin({ top: 6 })
          .width('100%')
        Row({ space: 10 }) {
          TextInput({ text: this.goalInputText, placeholder: '68' })
            .type(InputType.NUMBER_DECIMAL)
            .fontFamily('Inter')
            .fontSize(20)
            .fontWeight(FontWeight.Medium)
            .fontColor('#F7FBF8')
            .placeholderColor('#4DFFFFFF')
            .placeholderFont({ size: 20, weight: FontWeight.Medium })
            .backgroundColor('#00000000')
            .layoutWeight(1)
            .height(40)
            .onChange((value: string) => {
              this.goalInputText = value
            })
          Text('kg')
            .fontFamily('Noto Sans SC')
            .fontSize(13)
            .fontColor('#8AFFFFFF')
        }
        .margin({ top: 16 })
        .padding({ left: 14, right: 14 })
        .backgroundColor('#171D24')
        .borderRadius(14)
        .border({ width: 1, color: '#1AFFFFFF' })
        Row({ space: 10 }) {
          Text('取消')
            .fontFamily('Noto Sans SC')
            .fontSize(13)
            .fontWeight(FontWeight.Medium)
            .fontColor('#B3FFFFFF')
            .height(40)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#0FFFFFFF')
            .borderRadius(999)
            .onClick(() => {
              this.closeGoalModal()
            })
          Text('保存')
            .fontFamily('Noto Sans SC')
            .fontSize(13)
            .fontWeight(FontWeight.Medium)
            .fontColor('#07100B')
            .height(40)
            .padding({ left: 16, right: 16 })
            .backgroundColor('#50ECA7')
            .borderRadius(999)
            .onClick(() => {
              this.saveGoal()
            })
        }
        .justifyContent(FlexAlign.End)
        .margin({ top: 18 })
        .width('100%')
      }
      .width(320)
      .padding(20)
      .backgroundColor('#10171B')
      .borderRadius(22)
      .border({ width: 1, color: '#1AFFFFFF' })
    }
    .width('100%')
    .height('100%')
  }
}

