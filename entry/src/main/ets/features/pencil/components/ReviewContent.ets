class BodymapPathFlattener {
  private static readonly NUMBER_RE: RegExp = /^[+-]?(?:\d+\.\d+|\d+\.?|\.\d+)(?:[eE][+-]?\d+)?/
  private static readonly CUBIC_STEPS: number = 16
  private static readonly QUAD_STEPS: number = 10
  private static readonly ARC_STEPS: number = 8

  private path: string = ''
  private pos: number = 0
  private currentPolygon: HitPoint[] = []
  private outPolygons: HitPoint[][] = []
  private curX: number = 0
  private curY: number = 0
  private startX: number = 0
  private startY: number = 0
  private lastCommand: string = ''

  flatten(path: string): HitPoint[][] {
    this.path = path
    this.pos = 0
    this.currentPolygon = []
    this.outPolygons = []
    this.curX = 0
    this.curY = 0
    this.startX = 0
    this.startY = 0
    this.lastCommand = ''
    while (this.hasMore()) {
      if (this.peekIsNumber()) {
        if (this.lastCommand === 'M') {
          this.execCommand('L')
        } else if (this.lastCommand === 'm') {
          this.execCommand('l')
        } else {
          this.execCommand(this.lastCommand)
        }
        continue
      }
      const command: string = this.nextCommand()
      this.execCommand(command)
    }
    if (this.currentPolygon.length > 0) {
      this.outPolygons.push(this.currentPolygon)
      this.currentPolygon = []
    }
    return this.outPolygons
  }

  static pointInPolygon(px: number, py: number, vertices: HitPoint[]): boolean {
    let inside: boolean = false
    let j: number = vertices.length - 1
    for (let i = 0; i < vertices.length; i++) {
      const yi: number = vertices[i].y
      const yj: number = vertices[j].y
      if ((yi > py) !== (yj > py)) {
        const xi: number = vertices[i].x
        const xj: number = vertices[j].x
        const crossX: number = ((xj - xi) * (py - yi)) / (yj - yi) + xi
        if (px < crossX) {
          inside = !inside
        }
      }
      j = i
    }
    return inside
  }

  private skipSeparators(): void {
    while (this.pos < this.path.length) {
      const ch: string = this.path.charAt(this.pos)
      if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r' || ch === ',') {
        this.pos++
      } else {
        break
      }
    }
  }

  private hasMore(): boolean {
    this.skipSeparators()
    return this.pos < this.path.length
  }

  private peekIsNumber(): boolean {
    this.skipSeparators()
    if (this.pos >= this.path.length) {
      return false
    }
    const code: number = this.path.charCodeAt(this.pos)
    return !((code >= 65 && code <= 90) || (code >= 97 && code <= 122))
  }

  private nextCommand(): string {
    this.skipSeparators()
    if (this.pos < this.path.length) {
      const ch: string = this.path.charAt(this.pos)
      this.pos++
      return ch
    }
    return ''
  }

  private nextNumber(): number {
    this.skipSeparators()
    if (this.pos >= this.path.length) {
      return 0
    }
    const rest: string = this.path.substring(this.pos)
    const match: RegExpExecArray | null = BodymapPathFlattener.NUMBER_RE.exec(rest)
    if (match === null) {
      return 0
    }
    this.pos += match[0].length
    return Number(match[0])
  }

  private nextFlag(): number {
    this.skipSeparators()
    if (this.pos >= this.path.length) {
      return 0
    }
    const ch: string = this.path.charAt(this.pos)
    if (ch === '0' || ch === '1') {
      this.pos++
      return ch === '1' ? 1 : 0
    }
    return 0
  }

  private execCommand(command: string): void {
    if (command === 'M' || command === 'm') {
      this.execMove(command)
      return
    }
    if (command === 'L' || command === 'l') {
      this.execLine(command)
      return
    }
    if (command === 'C' || command === 'c') {
      this.execCubic(command)
      return
    }
    if (command === 'Q' || command === 'q') {
      this.execQuad(command)
      return
    }
    if (command === 'A' || command === 'a') {
      this.execArc(command)
      return
    }
    if (command === 'Z' || command === 'z') {
      this.execClose()
    }
  }

  private execMove(command: string): void {
    const x: number = this.nextNumber()
    const y: number = this.nextNumber()
    if (this.currentPolygon.length > 0) {
      this.outPolygons.push(this.currentPolygon)
    }
    this.currentPolygon = []
    if (command === 'm') {
      this.curX += x
      this.curY += y
    } else {
      this.curX = x
      this.curY = y
    }
    this.startX = this.curX
    this.startY = this.curY
    this.pushVertex(this.curX, this.curY)
    this.lastCommand = command
  }

  private execLine(command: string): void {
    const x: number = this.nextNumber()
    const y: number = this.nextNumber()
    if (command === 'l') {
      this.curX += x
      this.curY += y
    } else {
      this.curX = x
      this.curY = y
    }
    this.pushVertex(this.curX, this.curY)
    this.lastCommand = command
  }

  private execCubic(command: string): void {
    const c1x: number = this.nextNumber()
    const c1y: number = this.nextNumber()
    const c2x: number = this.nextNumber()
    const c2y: number = this.nextNumber()
    const x: number = this.nextNumber()
    const y: number = this.nextNumber()
    let c1xAbs: number = c1x
    let c1yAbs: number = c1y
    let c2xAbs: number = c2x
    let c2yAbs: number = c2y
    let x2: number = x
    let y2: number = y
    if (command === 'c') {
      c1xAbs = this.curX + c1x
      c1yAbs = this.curY + c1y
      c2xAbs = this.curX + c2x
      c2yAbs = this.curY + c2y
      x2 = this.curX + x
      y2 = this.curY + y
    }
    this.appendCubic(this.curX, this.curY, c1xAbs, c1yAbs, c2xAbs, c2yAbs, x2, y2)
    this.curX = x2
    this.curY = y2
    this.lastCommand = command
  }

  private execQuad(command: string): void {
    const cx: number = this.nextNumber()
    const cy: number = this.nextNumber()
    const x: number = this.nextNumber()
    const y: number = this.nextNumber()
    let cxAbs: number = cx
    let cyAbs: number = cy
    let x2: number = x
    let y2: number = y
    if (command === 'q') {
      cxAbs = this.curX + cx
      cyAbs = this.curY + cy
      x2 = this.curX + x
      y2 = this.curY + y
    }
    this.appendQuad(this.curX, this.curY, cxAbs, cyAbs, x2, y2)
    this.curX = x2
    this.curY = y2
    this.lastCommand = command
  }

  private execArc(command: string): void {
    const rx: number = this.nextNumber()
    const ry: number = this.nextNumber()
    const rotation: number = this.nextNumber()
    const largeArc: number = this.nextFlag()
    const sweep: number = this.nextFlag()
    const x: number = this.nextNumber()
    const y: number = this.nextNumber()
    let x2: number = x
    let y2: number = y
    if (command === 'a') {
      x2 = this.curX + x
      y2 = this.curY + y
    }
    this.appendArc(this.curX, this.curY, x2, y2, rx, ry, rotation, largeArc, sweep)
    this.curX = x2
    this.curY = y2
    this.lastCommand = command
  }

  private execClose(): void {
    if (this.currentPolygon.length > 0) {
      this.currentPolygon.push({ x: this.startX, y: this.startY })
      this.outPolygons.push(this.currentPolygon)
      this.currentPolygon = []
    }
    this.curX = this.startX
    this.curY = this.startY
    this.lastCommand = 'Z'
  }

  private pushVertex(x: number, y: number): void {
    const point: HitPoint = { x: x, y: y }
    this.currentPolygon.push(point)
  }

  private appendCubic(x1: number, y1: number, c1x: number, c1y: number, c2x: number, c2y: number, x2: number, y2: number): void {
    const steps: number = BodymapPathFlattener.CUBIC_STEPS
    for (let step = 1; step <= steps; step++) {
      const t: number = step / steps
      const mt: number = 1 - t
      const a: number = mt * mt * mt
      const b: number = 3 * mt * mt * t
      const c: number = 3 * mt * t * t
      const d: number = t * t * t
      this.pushVertex(a * x1 + b * c1x + c * c2x + d * x2, a * y1 + b * c1y + c * c2y + d * y2)
    }
  }

  private appendQuad(x1: number, y1: number, cx: number, cy: number, x2: number, y2: number): void {
    const steps: number = BodymapPathFlattener.QUAD_STEPS
    for (let step = 1; step <= steps; step++) {
      const t: number = step / steps
      const mt: number = 1 - t
      this.pushVertex(mt * mt * x1 + 2 * mt * t * cx + t * t * x2, mt * mt * y1 + 2 * mt * t * cy + t * t * y2)
    }
  }

  private appendArc(x1: number, y1: number, x2: number, y2: number, rxIn: number, ryIn: number,
    rotationDeg: number, largeArcFlag: number, sweepFlag: number): void {
    let rx: number = Math.abs(rxIn)
    let ry: number = Math.abs(ryIn)
    if (rx < 0.0001 || ry < 0.0001) {
      this.pushVertex(x2, y2)
      return
    }
    const phi: number = (rotationDeg * Math.PI) / 180
    const cosPhi: number = Math.cos(phi)
    const sinPhi: number = Math.sin(phi)
    const dx: number = (x1 - x2) / 2
    const dy: number = (y1 - y2) / 2
    const x1p: number = cosPhi * dx + sinPhi * dy
    const y1p: number = -sinPhi * dx + cosPhi * dy
    const lambda: number = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry)
    if (lambda > 1) {
      const factor: number = Math.sqrt(lambda)
      rx = rx * factor
      ry = ry * factor
    }
    const rxSq: number = rx * rx
    const rySq: number = ry * ry
    const x1pSq: number = x1p * x1p
    const y1pSq: number = y1p * y1p
    const numerator: number = rxSq * rySq - rxSq * y1pSq - rySq * x1pSq
    const denominator: number = rxSq * y1pSq + rySq * x1pSq
    let coef: number = 0
    if (denominator > 0.000001) {
      coef = Math.sqrt(Math.max(0, numerator / denominator))
    }
    if (largeArcFlag === sweepFlag) {
      coef = -coef
    }
    const cxp: number = coef * ((rx * y1p) / ry)
    const cyp: number = coef * (-(ry * x1p) / rx)
    const cx: number = cosPhi * cxp - sinPhi * cyp + (x1 + x2) / 2
    const cy: number = sinPhi * cxp + cosPhi * cyp + (y1 + y2) / 2
    const theta1: number = this.arcAngle((x1p - cxp) / rx, (y1p - cyp) / ry)
    let deltaTheta: number = this.arcAngle((-x1p - cxp) / rx, (-y1p - cyp) / ry) - theta1
    if (sweepFlag === 0 && deltaTheta > 0) {
      deltaTheta -= 2 * Math.PI
    } else if (sweepFlag !== 0 && deltaTheta < 0) {
      deltaTheta += 2 * Math.PI
    }
    const steps: number = BodymapPathFlattener.ARC_STEPS
    for (let step = 1; step <= steps; step++) {
      const theta: number = theta1 + deltaTheta * (step / steps)
      const rxCos: number = rx * Math.cos(theta)
      const rySin: number = ry * Math.sin(theta)
      const px: number = cx + cosPhi * rxCos - sinPhi * rySin
      const py: number = cy + sinPhi * rxCos + cosPhi * rySin
      this.pushVertex(px, py)
    }
  }

  private arcAngle(ux: number, uy: number): number {
    let angle: number = Math.atan2(uy, ux)
    if (angle < 0) {
      angle += 2 * Math.PI
    }
    return angle
  }
}

function buildMuscleHitRegions(view: BodymapViewData): MuscleHitRegion[] {
  const flattener: BodymapPathFlattener = new BodymapPathFlattener()
  const regions: MuscleHitRegion[] = []
  for (let muscleIndex = 0; muscleIndex < view.muscles.length; muscleIndex++) {
    const muscle: BodymapMuscleData = view.muscles[muscleIndex]
    const polygons: HitPoint[][] = []
    for (let pathIndex = 0; pathIndex < muscle.paths.length; pathIndex++) {
      const subPolygons: HitPoint[][] = flattener.flatten(muscle.paths[pathIndex])
      for (let subIndex = 0; subIndex < subPolygons.length; subIndex++) {
        polygons.push(subPolygons[subIndex])
      }
    }
    let minX: number = 1e9
    let minY: number = 1e9
    let maxX: number = -1e9
    let maxY: number = -1e9
    for (let polyIndex = 0; polyIndex < polygons.length; polyIndex++) {
      const vertices: HitPoint[] = polygons[polyIndex]
      for (let vertexIndex = 0; vertexIndex < vertices.length; vertexIndex++) {
        const point: HitPoint = vertices[vertexIndex]
        if (point.x < minX) {
          minX = point.x
        }
        if (point.x > maxX) {
          maxX = point.x
        }
        if (point.y < minY) {
          minY = point.y
        }
        if (point.y > maxY) {
          maxY = point.y
        }
      }
    }
    const region: MuscleHitRegion = {
      key: muscle.key,
      minX: minX,
      minY: minY,
      maxX: maxX,
      maxY: maxY,
      polygons: polygons
    }
    regions.push(region)
  }
  return regions
}

function hitTestMuscleView(regions: MuscleHitRegion[], modelX: number, modelY: number): string {
  for (let index = regions.length - 1; index >= 0; index--) {
    const region: MuscleHitRegion = regions[index]
    if (modelX < region.minX || modelX > region.maxX || modelY < region.minY || modelY > region.maxY) {
      continue
    }
    for (let polyIndex = 0; polyIndex < region.polygons.length; polyIndex++) {
      if (BodymapPathFlattener.pointInPolygon(modelX, modelY, region.polygons[polyIndex])) {
        return region.key
      }
    }
  }
  return ''
}


@Component
export struct ReviewContent {
  @State private timeScale: string = 'week'
  @State private segKey: string = ''
  @State private summary: ReviewDashboardSummary = ReviewDashboardService.createEmptySummary()
  @State private weekBars: ReviewBarItem[] = []
  @State private trendItems: ReviewWeeklyTrendItem[] = []
  @State private monthLabel: string = ''
  @State private monthBadge: string = ''
  @State private weekRangeText: string = ''
  @State private trainDays: number[] = []
  @State private calendarDays: number[] = []
  @State private todayDay: number = -1
  @State private monthSessionCount: number = 0
  @State private monthDurationMinutes: number = 0
  @State private muscleMode: string = 'balance'
  @State private effortMode: string = 'rir'
  @State private showGoalModal: boolean = false
  @State private goalWeight: number = 68
  @State private goalInputText: string = '68'
  @State private selectedMuscleKey: string = ''
  @State private monthDayLevels: number[] = []
  @State private calendarLeadDays: number = 0
  @State private goalPressed: boolean = false

  private mmFrontSettings: RenderingContextSettings = new RenderingContextSettings(true)
  private mmFrontContext: CanvasRenderingContext2D = new CanvasRenderingContext2D(this.mmFrontSettings)
  private mmBackSettings: RenderingContextSettings = new RenderingContextSettings(true)
  private mmBackContext: CanvasRenderingContext2D = new CanvasRenderingContext2D(this.mmBackSettings)
  private wgSettings: RenderingContextSettings = new RenderingContextSettings(true)
  private wgContext: CanvasRenderingContext2D = new CanvasRenderingContext2D(this.wgSettings)
  private frontHitRegions: MuscleHitRegion[] = []
  private backHitRegions: MuscleHitRegion[] = []

  async aboutToAppear(): Promise<void> {
    const now: number = Date.now()
    this.initCalendarShell(now)
    const context = this.getUIContext().getHostContext()
    if (context === undefined) {
      this.applyEmptyState()
      return
    }
    try {
      const sessions: WorkoutSession[] = await WorkoutSessionPersistenceBridgeService.loadPersistedSessions(context)
      if (sessions.length === 0) {
        this.summary = ReviewDashboardService.createEmptySummary()
      } else {
        this.summary = ReviewDashboardService.createSummary(sessions)
      }
      this.trendItems = ReviewInsightsService.createWeeklyTrendItems(sessions, now)
      this.weekBars = this.buildWeekBars(sessions, now)
      this.initCalendarData(sessions, now)
    } catch (error) {
      this.applyEmptyState()
    }
  }

  private applyEmptyState(): void {
    this.summary = ReviewDashboardService.createEmptySummary()
    this.trendItems = []
    this.weekBars = []
    this.trainDays = []
    this.monthDayLevels = []
    this.monthSessionCount = 0
    this.monthDurationMinutes = 0
  }

  private initCalendarShell(now: number): void {
    const date: Date = new Date(now)
    const year: number = date.getFullYear()
    const month: number = date.getMonth()
    this.monthLabel = year.toString() + ' 年 ' + (month + 1).toString() + ' 月'
    this.monthBadge = '本月 · ' + (month + 1).toString() + '月'
    this.weekRangeText = this.formatWeekRange(now)
    this.todayDay = date.getDate()
    const firstWeekday: number = new Date(year, month, 1).getDay()
    this.calendarLeadDays = (firstWeekday + 6) % 7
    const daysInMonth: number = new Date(year, month + 1, 0).getDate()
    const days: number[] = []
    for (let day = 1; day <= daysInMonth; day++) {
      days.push(day)
    }
    this.calendarDays = days
  }

  private initCalendarData(sessions: WorkoutSession[], now: number): void {
    const date: Date = new Date(now)
    const year: number = date.getFullYear()
    const month: number = date.getMonth()
    const trainDays: number[] = []
    let sessionCount: number = 0
    let durationSeconds: number = 0
    const daysInMonth: number = this.calendarDays.length
    const dayVolumes: number[] = []
    for (let day = 0; day <= daysInMonth; day++) {
      dayVolumes.push(0)
    }
    for (let index = 0; index < sessions.length; index++) {
      const sessionDate: Date = new Date(sessions[index].startedAt)
      if (sessionDate.getFullYear() !== year || sessionDate.getMonth() !== month) {
        continue
      }
      sessionCount++
      durationSeconds += sessions[index].durationSeconds
      const day: number = sessionDate.getDate()
      if (!this.containsDay(trainDays, day)) {
        trainDays.push(day)
      }
      dayVolumes[day] += this.countWorkingSets(sessions[index])
    }
    let maxVolume: number = 0
    for (let day = 1; day <= daysInMonth; day++) {
      if (dayVolumes[day] > maxVolume) {
        maxVolume = dayVolumes[day]
      }
    }
    const levels: number[] = []
    for (let day = 0; day <= daysInMonth; day++) {
      levels.push(0)
    }
    for (let day = 1; day <= daysInMonth; day++) {
      const volume: number = dayVolumes[day]
      if (volume <= 0 || maxVolume <= 0) {
        levels[day] = 0
        continue
      }
      const ratio: number = volume / maxVolume
      if (ratio > 0.75) {
        levels[day] = 4
      } else if (ratio > 0.5) {
        levels[day] = 3
      } else if (ratio > 0.25) {
        levels[day] = 2
      } else {
        levels[day] = 1
      }
    }
    this.trainDays = trainDays
    this.monthSessionCount = sessionCount
    this.monthDurationMinutes = Math.round(durationSeconds / 60)
    this.monthDayLevels = levels
  }

  private containsDay(days: number[], target: number): boolean {
    for (let index = 0; index < days.length; index++) {
      if (days[index] === target) {
        return true
      }
    }
    return false
  }

  private formatWeekRange(now: number): string {
    const date: Date = new Date(now)
    const dayOfWeek: number = date.getDay()
    const mondayOffset: number = dayOfWeek === 0 ? 6 : dayOfWeek - 1
    const monday: Date = new Date(date.getFullYear(), date.getMonth(), date.getDate() - mondayOffset)
    const sunday: Date = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + 6)
    const mondayText: string = (monday.getMonth() + 1).toString() + '月' + monday.getDate().toString() + '日'
    const sundayText: string = (sunday.getMonth() + 1).toString() + '月' + sunday.getDate().toString() + '日'
    return mondayText + '–' + sundayText
  }

  private buildWeekBars(sessions: WorkoutSession[], now: number): ReviewBarItem[] {
    const date: Date = new Date(now)
    const dayOfWeek: number = date.getDay()
    const mondayOffset: number = dayOfWeek === 0 ? 6 : dayOfWeek - 1
    const monday: Date = new Date(date.getFullYear(), date.getMonth(), date.getDate() - mondayOffset)
    const setsPerDay: number[] = []
    let maxSets: number = 0
    for (let dayIndex = 0; dayIndex < 7; dayIndex++) {
      const dayStart: number = new Date(
        monday.getFullYear(), monday.getMonth(), monday.getDate() + dayIndex
      ).getTime()
      const dayEnd: number = dayStart + 24 * 60 * 60 * 1000
      let daySets: number = 0
      for (let sessionIndex = 0; sessionIndex < sessions.length; sessionIndex++) {
        const startedAt: number = sessions[sessionIndex].startedAt
        if (startedAt >= dayStart && startedAt < dayEnd) {
          daySets += this.countWorkingSets(sessions[sessionIndex])
        }
      }
      setsPerDay.push(daySets)
      if (daySets > maxSets) {
        maxSets = daySets
      }
    }
    const bars: ReviewBarItem[] = []
    for (let index = 0; index < 7; index++) {
      let height: number = 6
      if (maxSets > 0 && setsPerDay[index] > 0) {
        height = 12 + (setsPerDay[index] / maxSets) * 93
      }
      const bar: ReviewBarItem = {
        label: WEEKDAY_LABELS[index],
        height: height,
        active: setsPerDay[index] > 0
      }
      bars.push(bar)
    }
    return bars
  }

  private countWorkingSets(session: WorkoutSession): number {
    let count: number = 0
    for (let index = 0; index < session.sets.length; index++) {
      const set: WorkoutSet = session.sets[index]
      if (set.weight > 0 && set.reps > 0 && !set.isWarmup) {
        count++
      }
    }
    return count
  }

  private weekText(): string {
    if (this.timeScale === 'month') {
      return this.monthBadge
    }
    return '本周 · ' + this.weekRangeText
  }

  private badgeText(): string {
    if (!this.summary.hasSessions) {
      return '待积累'
    }
    if (!this.summary.trendSummary.hasTrend) {
      return '首次复盘'
    }
    const delta: number = this.summary.trendSummary.recentCompletionRate -
      this.summary.trendSummary.previousCompletionRate
    if (delta > 0) {
      return '↑ +' + delta.toString() + '%'
    }
    if (delta < 0) {
      return '↓ -' + Math.abs(delta).toString() + '%'
    }
    return '— 持平'
  }

  private headlineText(): string {
    if (!this.summary.hasSessions) {
      return '完成一次训练，开始你的复盘。'
    }
    if (this.summary.trendSummary.hasTrend) {
      return this.summary.trendSummary.summaryText
    }
    return '状态不错，继续保持。'
  }

  private descriptionText(): string {
    if (!this.summary.hasSessions) {
      return '完成第一次训练后，这里会汇总训练次数、时长与体重变化。'
    }
    if (this.timeScale === 'month') {
      return '本月已完成 ' + this.monthSessionCount.toString() + ' 次训练，平均每周 ' +
        this.monthWeeklyAverage() + ' 次，累计训练 ' + this.monthDurationMinutes.toString() + ' 分钟。'
    }
    if (this.trendItems.length > 0) {
      return this.trendItems[0].summaryText
    }
    return '继续按计划训练，保持稳定节奏。'
  }

  private monthWeeklyAverage(): string {
    const date: Date = new Date()
    const dayOfMonth: number = date.getDate()
    const elapsedWeeks: number = Math.max(1, Math.ceil(dayOfMonth / 7))
    const average: number = Math.round((this.monthSessionCount / elapsedWeeks) * 10) / 10
    return average.toString()
  }

  private statValue(index: number): string {
    if (index === 0) {
      return this.summary.sessionCount.toString()
    }
    if (index === 1) {
      return Math.round(this.summary.totalDurationSeconds / 60).toString()
    }
    if (!this.summary.hasSessions) {
      return '—'
    }
    return this.timeScale === 'month' ? '-1.6' : '-0.8'
  }

  private staticIndex(list: string[], target: string): number {
    for (let index = 0; index < list.length; index++) {
      if (list[index] === target) {
        return index
      }
    }
    return -1
  }

  private currentLevels(): number[] {
    if (this.muscleMode === 'fatigue') {
      return MM_LEVELS_FATIGUE
    }
    if (this.muscleMode === 'strength') {
      return MM_LEVELS_STRENGTH
    }
    return MM_LEVELS_BALANCE
  }

  private currentFills(): string[] {
    if (this.muscleMode === 'fatigue') {
      return FATIGUE_FILLS
    }
    if (this.muscleMode === 'strength') {
      return STRENGTH_FILLS
    }
    return BALANCE_FILLS
  }

  private currentLegend(): string[] {
    if (this.muscleMode === 'fatigue') {
      return FATIGUE_LEGEND
    }
    if (this.muscleMode === 'strength') {
      return STRENGTH_LEGEND
    }
    return BALANCE_LEGEND
  }

  private muscleLevel(key: string): number {
    const index: number = this.staticIndex(MM_MUSCLE_KEYS, key)
    if (index < 0) {
      return 0
    }
    return this.currentLevels()[index]
  }

  private muscleFill(level: number): string {
    const fills: string[] = this.currentFills()
    if (level <= 0) {
      return MUSCLE_BASE_FILL
    }
    if (level > fills.length) {
      return fills[fills.length - 1]
    }
    return fills[level - 1]
  }

  private muscleMeta(): string {
    if (this.muscleMode === 'fatigue') {
      return '当前恢复状态'
    }
    if (this.muscleMode === 'strength') {
      return '力量与最佳成绩'
    }
    return '近 30 天 · 训练量'
  }

  private muscleNote(): string {
    if (this.muscleMode === 'fatigue') {
      return '腿部与臀部疲劳度较高，建议优先恢复。'
    }
    if (this.muscleMode === 'strength') {
      return '胸部与腿部力量最强，核心相对薄弱。'
    }
    return '胸部训练量最高，核心最少。'
  }

  private muscleLabel(key: string): string {
    const index: number = this.staticIndex(MM_MUSCLE_KEYS, key)
    if (index < 0 || index >= MM_MUSCLE_LABELS.length) {
      return ''
    }
    return MM_MUSCLE_LABELS[index]
  }

  private muscleStatWord(level: number, words: string[]): string {
    const index: number = level - 1
    if (index < 0 || index >= words.length) {
      return '—'
    }
    return words[index]
  }

  private muscleDetailValue(): string {
    const level: number = this.muscleLevel(this.selectedMuscleKey)
    if (this.muscleMode === 'balance') {
      return (level * 10 + 8).toString() + ' 组'
    }
    if (this.muscleMode === 'fatigue') {
      return this.muscleStatWord(level, MM_FATIGUE_WORDS)
    }
    return this.muscleStatWord(level, MM_STRENGTH_WORDS)
  }

  private muscleDetailBarWidth(): string {
    const level: number = this.muscleLevel(this.selectedMuscleKey)
    return (level * 25).toString() + '%'
  }

  private effortAverage(): string {
    let sum: number = 0
    for (let index = 0; index < RIR_BARS.length; index++) {
      if (this.effortMode === 'rpe') {
        sum += 10 - RIR_BARS[index]
      } else {
        sum += RIR_BARS[index]
      }
    }
    const average: number = sum / RIR_BARS.length
    return average.toFixed(1)
  }

  private effortUnitText(): string {
    if (this.effortMode === 'rpe') {
      return 'RPE · 近 8 次平均'
    }
    return 'RIR · 近 8 次平均'
  }

  private effortBarHeight(index: number): number {
    const raw: number = RIR_BARS[index]
    let percent: number = 0
    if (this.effortMode === 'rpe') {
      percent = ((10 - raw - 6) / 4) * 100
    } else {
      percent = (raw / 4) * 100
    }
    if (percent < 8) {
      percent = 8
    }
    return percent * 0.96
  }

  private goalWeightText(): string {
    if (this.goalWeight % 1 === 0) {
      return this.goalWeight.toString()
    }
    return this.goalWeight.toFixed(1)
  }

  private goalLineY(): number {
    const raw: number = 16 + ((71 - this.goalWeight) / 4) * 100
    if (raw < 16) {
      return 16
    }
    if (raw > 116) {
      return 116
    }
    return raw
  }

  private openGoalModal(): void {
    this.goalInputText = this.goalWeightText()
    this.showGoalModal = true
  }

  private closeGoalModal(): void {
    this.showGoalModal = false
  }

  private saveGoal(): void {
    let value: number = Number(this.goalInputText)
    if (Number.isNaN(value)) {
      value = 68
    }
    if (value < 30) {
      value = 30
    }
    if (value > 200) {
      value = 200
    }
    this.goalWeight = value
    this.showGoalModal = false
    this.drawWeightChart()
  }

  private drawWeightChart(): void {
    const ctx: CanvasRenderingContext2D = this.wgContext
    const width: number = ctx.width
    const height: number = ctx.height
    if (width <= 0 || height <= 0) {
      return
    }
    ctx.clearRect(0, 0, width, height)
    const scaleX: number = width / 342
    const scaleY: number = height / 132
    ctx.save()
    ctx.scale(scaleX, scaleY)
    ctx.strokeStyle = 'rgba(255,255,255,0.06)'
    ctx.lineWidth = 1
    const gridRows: number[] = [16, 44, 72, 100]
    for (let index = 0; index < gridRows.length; index++) {
      ctx.beginPath()
      ctx.moveTo(12, gridRows[index])
      ctx.lineTo(330, gridRows[index])
      ctx.stroke()
    }
    const goalY: number = this.goalLineY()
    ctx.strokeStyle = 'rgba(255,255,255,0.32)'
    ctx.setLineDash([4, 4])
    ctx.beginPath()
    ctx.moveTo(12, goalY)
    ctx.lineTo(330, goalY)
    ctx.stroke()
    ctx.setLineDash([])
    ctx.fillStyle = 'rgba(80,236,167,0.12)'
    ctx.beginPath()
    ctx.moveTo(12, 120)
    for (let index = 0; index < WEIGHT_CHART_POINTS.length; index++) {
      ctx.lineTo(WEIGHT_CHART_POINTS[index].x, WEIGHT_CHART_POINTS[index].y)
    }
    ctx.lineTo(330, 120)
    ctx.closePath()
    ctx.fill()
    ctx.strokeStyle = '#50ECA7'
    ctx.lineWidth = 2.5
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'
    ctx.beginPath()
    ctx.moveTo(WEIGHT_CHART_POINTS[0].x, WEIGHT_CHART_POINTS[0].y)
    for (let index = 1; index < WEIGHT_CHART_POINTS.length; index++) {
      ctx.lineTo(WEIGHT_CHART_POINTS[index].x, WEIGHT_CHART_POINTS[index].y)
    }
    ctx.stroke()
    ctx.fillStyle = '#50ECA7'
    for (let index = 0; index < WEIGHT_CHART_POINTS.length; index++) {
      ctx.beginPath()
      ctx.arc(WEIGHT_CHART_POINTS[index].x, WEIGHT_CHART_POINTS[index].y, 3, 0, Math.PI * 2)
      ctx.fill()
    }
    ctx.restore()
  }

  private drawBodymapFront(): void {
    this.drawBodymapView(this.mmFrontContext, BODYMAP_FRONT)
  }

  private drawBodymapBack(): void {
    this.drawBodymapView(this.mmBackContext, BODYMAP_BACK)
  }

  private redrawBodymaps(): void {
    this.drawBodymapFront()
    this.drawBodymapBack()
  }

  private ensureHitRegions(): void {
    if (this.frontHitRegions.length === 0) {
      this.frontHitRegions = buildMuscleHitRegions(BODYMAP_FRONT)
      this.backHitRegions = buildMuscleHitRegions(BODYMAP_BACK)
    }
  }

  private handleBodymapTap(event: ClickEvent, ctx: CanvasRenderingContext2D, view: BodymapViewData, regions: MuscleHitRegion[]): void {
    const width: number = ctx.width
    const height: number = ctx.height
    if (width <= 0 || height <= 0) {
      return
    }
    const modelX: number = (event.x * view.viewWidth) / width + view.offsetX
    const modelY: number = (event.y * view.viewHeight) / height + view.offsetY
    const hit: string = hitTestMuscleView(regions, modelX, modelY)
    if (hit !== '') {
      this.selectedMuscleKey = hit
      this.redrawBodymaps()
    }
  }

  private handleFrontBodymapTap(event: ClickEvent): void {
    this.ensureHitRegions()
    this.handleBodymapTap(event, this.mmFrontContext, BODYMAP_FRONT, this.frontHitRegions)
  }

  private handleBackBodymapTap(event: ClickEvent): void {
    this.ensureHitRegions()
    this.handleBodymapTap(event, this.mmBackContext, BODYMAP_BACK, this.backHitRegions)
  }

  private drawBodymapView(ctx: CanvasRenderingContext2D, view: BodymapViewData): void {
    const width: number = ctx.width
    const height: number = ctx.height
    if (width <= 0 || height <= 0) {
      return
    }
    ctx.clearRect(0, 0, width, height)
    const scaleX: number = width / view.viewWidth
    const scaleY: number = height / view.viewHeight
    ctx.save()
    ctx.scale(scaleX, scaleY)
    ctx.translate(-view.offsetX, -view.offsetY)
    ctx.lineJoin = 'round'
    ctx.lineWidth = 2.5
    ctx.fillStyle = SILHOUETTE_FILL
    ctx.strokeStyle = BODY_PATH_STROKE
    for (let index = 0; index < view.outline.length; index++) {
      const path2d: Path2D = new Path2D(view.outline[index])
      ctx.fill(path2d)
      ctx.stroke(path2d)
    }
    for (let muscleIndex = 0; muscleIndex < view.muscles.length; muscleIndex++) {
      const muscle: BodymapMuscleData = view.muscles[muscleIndex]
      const level: number = this.muscleLevel(muscle.key)
      ctx.fillStyle = this.muscleFill(level)
      const isSelected: boolean = muscle.key === this.selectedMuscleKey
      ctx.strokeStyle = isSelected ? SELECTED_MUSCLE_STROKE : BODY_PATH_STROKE
      ctx.lineWidth = isSelected ? 7 : 2.5
      for (let pathIndex = 0; pathIndex < muscle.paths.length; pathIndex++) {
        const path2d: Path2D = new Path2D(muscle.paths[pathIndex])
        ctx.fill(path2d)
        ctx.stroke(path2d)
      }
    }
    ctx.restore()
  }

