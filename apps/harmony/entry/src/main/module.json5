{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 第三方登录 scheme 声明（微信/QQ 官方要求）：
    //  - weixin    ：微信，用于 WXApi.isWXAppInstalled() 判断是否安装
    //  - wxopensdk ：微信，用于跳转微信授权
    //  - https     ：QQ 官方要求（其 SDK 内部走 https 跳转）
    //  - qqopenapi ：QQ，用于接收 QQ 授权回调
    "querySchemes": [
      "weixin",
      "wxopensdk",
      "https",
      "qqopenapi"
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      // 训练页「完成一组」触觉反馈（normal 级权限，声明即得；设置页「声音与震动」开关门控）。
      // 注：训练提醒的系统级代理提醒需 ohos.permission.PUBLISH_AGENT_REMINDER（受限权限）——
      // 按本计划决策 2 暂不声明（待 AGC 开放能力申请批准 + profile 更新后与本行一并启用），
      // 期间提醒走应用内降级通道（见 common/services/WorkoutReminderService.ets 注释）。
      {
        "name": "ohos.permission.VIBRATE"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          // QQ 授权回调：entity.system.browsable + viewData + qqopenapi scheme。
          // ⚠ host 必须等于应用在 QQ 互联申请到的 AppID（填写错误会导致 QQ 无法回调，
          //   腾讯官方明确警告）。真值放 rawfile thirdparty.json（不入库），
          //   此处按 ohos 规范需为字面量——发布前须用真实 AppID 替换 <QQ_APP_ID>。
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "qqopenapi",
                "host": "<QQ_APP_ID>",
                "pathRegex": "\\b(auth|share)\\b"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}