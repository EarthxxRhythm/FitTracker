<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 账号登录与云同步（Supabase）——与隐私政策第四节一致。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 训练触觉反馈（「声音与震动」设置生效，Wave 3）——普通权限，声明即得。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 训练/成就提醒本地通知（Android 13+ 需运行时请求，Wave 4）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Android 11+（API 30）包可见性：未声明 <queries> 时，isQQInstalled() /
      isWXAppInstalled() 会返回 false（getPackageInfo 抛 NameNotFoundException），
      第三方登录直接失效。真机实测（PKB110 / Android 16）：
        openSDK_LOG.SystemUtils: isQQInstalled false
        openSDK_LOG.Util: getPackageInfo has exception: com.tencent.mobileqq
      而 QQ 实际已安装。故必须显式声明要探测的两个包。
    -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitTracker">

        <!-- Wave 6：per-app language 自动持久化（AppCompat 官方模板；API<33 镜像到系统存储）。 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FitTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深链接：fittracker://<routeId>，用于外部直达与验收脚本 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fittracker" />
            </intent-filter>
        </activity>

        <!--
          微信回调入口。路径 {applicationId}.wxapi.WXEntryActivity 是微信 Android SDK 的
          硬性约定（applicationId = com.earthrhythm.fittracker），声明错误会导致授权后
          无法回到应用。exported=true 必需（微信为外部调用方）。
          launchMode=singleTask 避免回调重复创建实例。
        -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FitTracker" />

        <!--
          QQ 互联 SDK 回调声明（官方硬性要求，缺失会导致 Tencent.createInstance 抛异常）。

          1) AuthActivity：接收 QQ 授权后的回跳。
             scheme 必须为 `tencent<APPID>`，通过 manifestPlaceholders 注入（见 build.gradle.kts），
             避免把 AppID 硬编码进这份入库文件。
          2) AssistActivity：QQ 未安装时的网页登录兜底。
        -->
        <activity
            android:name="com.tencent.tauth.AuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tencent${qqAppId}" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.tencent.connect.common.AssistActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="behind"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false" />
    </application>

</manifest>
