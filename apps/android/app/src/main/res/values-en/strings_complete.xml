<?xml version="1.0" encoding="utf-8"?>
<!--
  English strings for the workout complete screen (+ FtCompleteModel). Keys mirror
  `values/strings_complete.xml` (the zh values there are the source of truth).
-->
<resources>

    <!-- Hero -->
    <string name="complete_title">Workout complete</string>
    <string name="complete_subtitle">Today\'s workout is saved. Great job.</string>

    <!-- Streak card -->
    <string name="complete_streak_title">Training streak</string>
    <string name="complete_streak_count">%1$d-day streak</string>
    <string name="complete_a11y_streak">This week\'s training streak: checked in Monday through Saturday, not checked in on Sunday</string>

    <!-- Bottom primary button -->
    <string name="complete_continue">Continue</string>
    <string name="complete_a11y_continue">Continue to workout summary</string>

    <!-- Session RPE capture card (mirrors zh source of truth) -->
    <string name="complete_rpe_title">Session intensity</string>
    <string name="complete_rpe_hint">1 easy · 10 max</string>
    <string name="complete_rpe_unrated">Not rated</string>
    <string name="complete_rpe_value">RPE %1$d%2$s</string>
    <!-- Leading space kept via \u0020: XML strips leading/trailing whitespace in element content. -->
    <string name="complete_rpe_saved">\u0020· saved</string>
    <string name="complete_a11y_rpe_option">Session intensity level %1$d, %2$s</string>
    <string name="complete_a11y_rpe_selected">selected</string>
    <string name="complete_a11y_rpe_unselected">not selected</string>

</resources>
