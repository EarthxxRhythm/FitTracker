<?xml version="1.0" encoding="utf-8"?>
<!--
  计划组详请域（planGroup 屏）文案。中文值**逐字**取自既有硬编码与原型（原型对齐纪律）：
  改动此处的中文即偏离原型，须同步原型
  `design/06_prototype_redraw/src/fittracker-plan-group-detail.html`。

  命名：`plangroup_<元素>`。带参文案用位置参数（`%1$s` / `%2$d`），由 UI 层 `stringResource(id, args)`
  或 `context.getString(...)` 解析。

  注：本屏内容目前**全部**来自屏内静态数据（`FtPlanGroupDetail`，原型 `PLAN` 逐字移植），
  故其计划名 / 描述 / 标签 / 天标题 / 肌群 / 动作名 / 器械 / 要领均属本域文案，一并资源化；
  日后接线到运行期计划数据时，改为数据层真源即可。
-->
<resources>

    <!-- 顶栏 / 返回 -->
    <!-- `.pgd-back` 的 `aria-label`（OD 新版 L390） -->
    <string name="plangroup_a11y_back">返回计划组</string>

    <!-- 概要卡（`.pgd-summary`，OD 新版 L172-193） -->
    <string name="plangroup_summary_label">计划组</string>
    <!-- 计划名（原型 `PLAN.name`，OD 新版 L438） -->
    <string name="plangroup_name">三分化（推拉腿）</string>
    <!-- 计划描述（原型 `PLAN.desc`） -->
    <string name="plangroup_desc">按动作模式循环：推（胸、肩、三头）、拉（背、二头）、腿（下肢）。每个部位每周练 1-2 次，适合各阶段训练者。</string>
    <!-- 概要卡三标签（原型同级字段 `audience`/`freq`/`totalDays` 拼装，OD 新版 L443） -->
    <string name="plangroup_tag_audience">初中高级通用</string>
    <string name="plangroup_tag_freq">3-6 天 / 周</string>
    <string name="plangroup_tag_days">3 个训练日</string>

    <!-- 每周节奏（`.pgd-rhythm`，OD 新版 L196-219）；`_push`/`_pull`/`_legs` 同时用作天页签与面板标题 -->
    <string name="plangroup_rhythm_title">每周节奏</string>
    <string name="plangroup_rhythm_push">推</string>
    <string name="plangroup_rhythm_pull">拉</string>
    <string name="plangroup_rhythm_legs">腿</string>
    <!-- 原型 `week` 里的 `'休'`：走 `.pgd-rhythm-cell.rest` 样式（见 `FtPlanGroupDetail.REST_INDEX`） -->
    <string name="plangroup_rhythm_rest">休</string>

    <!-- 星期标签（原型 `DOW`，OD 新版 L512） -->
    <string name="plangroup_dow_mon">一</string>
    <string name="plangroup_dow_tue">二</string>
    <string name="plangroup_dow_wed">三</string>
    <string name="plangroup_dow_thu">四</string>
    <string name="plangroup_dow_fri">五</string>
    <string name="plangroup_dow_sat">六</string>
    <string name="plangroup_dow_sun">日</string>

    <!-- 天页签（`.pgd-day-tab`，OD 新版 L222-248）：`%1$d` 天序号 -->
    <string name="plangroup_day_tab">第 %1$d 天</string>

    <!-- 当日肌群（`.pgd-day-head` 的 `.focus`） -->
