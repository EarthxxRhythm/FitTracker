    <string name="plangroup_cta_used">已切换到此计划</string>

    <!-- 浮层（`.pgd-toast`，OD 新版 L324-342）：`%1$s` 动作名 -->
    <string name="plangroup_toast_exercise">原型：查看「%1$s」详情</string>
    <!-- `%1$s` 计划名（`plangroup_name`） -->
