# ============================================================
# FitTracker 自托管部署 · 环境变量模板（本文件不含任何真实密钥，可进版本库）
#
# 用法（两段分开用）：
#   A 段 → 抄进 /opt/supabase/docker/.env 的对应处（.env 权限 600，不进版本库）
#   B 段 → 单独存为 /opt/fittracker/sms-hook.env（.sh/服务用，权限 600，不进版本库）
# ============================================================

# ------------------------------------------------------------
# A. Supabase 栈（/opt/supabase/docker/.env 的「覆盖项」）
#    注意：.env 由官方 .env.example 复制而来；以下只列需要你改动的项。
# ------------------------------------------------------------

# ① 密钥类 —— 不要手编，执行官方仓库自带脚本自动生成/写入：
#    sh utils/generate-keys.sh                   → POSTGRES_PASSWORD / JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY
#    sh utils/add-new-auth-keys.sh --update-env  → 新版 key（sb_publishable_… / sb_secret_…，变量名以脚本实际写入为准）
#    ⚠ 生成后把 ANON_KEY / 新 publishable key 抄给 app 用（见 Wave 6），其余留在服务器。

# ② 对外地址（替换为实际域名）：
SUPABASE_PUBLIC_URL=https://api.example.com
SITE_URL=https://api.example.com

# ③ API 网关端口（保持默认 8000；用 deploy/supabase-override/ 的 override 文件把监听限制为仅回环）：
API_GW_HTTP_PORT=8000

# ④ 短信 Send SMS Hook —— ⚠ 不在本 .env 里配！
#    经核验：官方 docker-compose.yml 中 auth 服务的三行 hook 变量是【被注释的字面量】
#    （master 版约在 241-243 行），仅写 .env 不会生效——必须编辑
#    /opt/supabase/docker/docker-compose.yml，找到并取消注释、替换为实际值：
#      GOTRUE_HOOK_SEND_SMS_ENABLED: "true"
#      GOTRUE_HOOK_SEND_SMS_URI: "https://api.example.com/sms-hook"
#      GOTRUE_HOOK_SEND_SMS_SECRETS: "v1,whsec_<与 B 段 SEND_SMS_HOOK_SECRET 同值>"
#    （secret 生成示例：openssl rand -base64 32，最终形态 v1,whsec_<base64>）
#    核实当前版本的确切行号与状态：
#      grep -n -i "hook_send_sms" /opt/supabase/docker/docker-compose.yml

# ⑤ Auth 配置对齐（与旧 supabase.com 项目 Dashboard → Auth 逐项对照）：
#    - Phone provider：启用（手机号 OTP 登录依赖）
#    - Email provider：按旧项目现状
#    - Confirm email（伪邮箱 @phone.fittracker.app 收不到邮件）：
#        若旧项目为「关闭确认」→ 新栈设置 GOTRUE_MAILER_AUTOCONFIRM=true
#    - OTP 有效期：**300 秒（5 分钟）**。⚠ 与 ④ 同一个坑——官方 compose 里这行是
#      【被注释的变量插值】（master 版第 197 行 `# GOTRUE_SMS_OTP_EXP: ${SMS_OTP_EXP}`），
#      仅改本 .env 不生效，必须编辑 /opt/supabase/docker/docker-compose.yml，把该行改为字面量：
#        GOTRUE_SMS_OTP_EXP: "300"
#      然后 `docker compose up -d auth` 重建容器，用 `docker exec supabase-auth env | grep SMS_OTP_EXP` 复核。
#      背景（2026-10-14 实测）：GoTrue 默认值为 **60 秒**，而阿里云短信模板文案是「5分钟内有效」
#      （见 B 段 ALIYUN_SMS_TEMPLATE_EXTRA_JSON 的 {"min":"5"}）——不改则文案与实际不符，
#      且 60 秒窗口让真人与自动化操作都极易超时。改 300 秒后实测：OTP 生成后 120 秒提交仍返回 200。
#    - rate limit：按旧项目现状（SMS_MAX_FREQUENCY 默认 60s，同一号码 60 秒内只能请求一次）

# ------------------------------------------------------------
# B. sms-hook 服务（存为 /opt/fittracker/sms-hook.env）——本段是独立文件，勿与 A 段混存
#    用法：docker run --env-file /opt/fittracker/sms-hook.env …
# ------------------------------------------------------------

# GoTrue 侧 Hook secret 的配对值（与 docker-compose.yml 的 GOTRUE_HOOK_SEND_SMS_SECRETS 完全一致）：
SEND_SMS_HOOK_SECRET=v1,whsec_<生成值 base64>

# 阿里云「号码认证服务·短信认证」RAM 子账号（从旧项目 Edge Function Secrets 抄录）：
ALIYUN_ACCESS_KEY_ID=<RAM 子账号 AccessKeyId>
ALIYUN_ACCESS_KEY_SECRET=<RAM 子账号 AccessKeySecret>
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_PARAM_KEY=code
ALIYUN_SMS_TEMPLATE_EXTRA_JSON={"min":"5"}

# 监听端口（默认 8787，与 Caddyfile 的 reverse_proxy 一致）：
PORT=8787
